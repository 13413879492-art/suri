<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>资源下载入口</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
        }
        body {
            background: #f2f4f8;
            min-height: 100vh;
            padding: 24px 16px;
            display: flex;
            justify-content: center;
        }
        .container {
            width: 100%;
            max-width: 480px;
        }
        .tip {
            background: #fff7e6;
            color: #8a5a00;
            border: 1px solid #ffe1a8;
            border-radius: 12px;
            padding: 14px 16px;
            margin-bottom: 20px;
            font-size: 14px;
            line-height: 1.7;
        }
        .title {
            text-align: center;
            font-size: 22px;
            font-weight: 700;
            color: #222;
            margin-bottom: 20px;
        }
        .card {
            background: #fff;
            border-radius: 14px;
            padding: 20px;
            margin-bottom: 16px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
        }
        .name {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .badge {
            display: inline-block;
            width: 26px;
            height: 26px;
            line-height: 26px;
            text-align: center;
            border-radius: 8px;
            color: #fff;
            font-size: 14px;
            font-weight: 700;
        }
        .bd-badge { background: #2d7dff; }
        .kk-badge { background: #6a32e1; }
        .xl-badge { background: #0088ff; }
        .code {
            font-size: 13px;
            color: #888;
            margin-bottom: 10px;
        }
        .link-box {
            font-size: 13px;
            color: #555;
            background: #f6f7f9;
            padding: 10px 12px;
            border-radius: 8px;
            word-break: break-all;
            line-height: 1.6;
            margin-bottom: 14px;
        }
        .btn-row {
            display: flex;
            gap: 10px;
        }
        .btn {
            flex: 1;
            text-align: center;
            padding: 12px 0;
            border: none;
            border-radius: 10px;
            color: #fff;
            font-size: 15px;
            cursor: pointer;
            text-decoration: none;
            transition: opacity 0.2s;
        }
        .btn:hover { opacity: 0.9; }
        .bd-btn { background: #2d7dff; }
        .kk-btn { background: #6a32e1; }
        .xl-btn { background: #0088ff; }
        .copy-btn { background: #9aa0a6; }
        .footer {
            text-align: center;
            font-size: 12px;
            color: #aaa;
            margin-top: 24px;
        }
    </style>
</head>
<body>
    <div class="container">

        <!-- 顶部提示：微信里网盘链接常被拦截 -->
        <div class="tip">
            ⚠️ 温馨提示：微信里经常会拦截网盘链接。如果点「打开」没反应，请点「复制」，再用手机浏览器或对应的网盘 App 粘贴打开。
        </div>

        <div class="title">资源下载入口</div>

        <!-- ===== 百度网盘卡片 ===== -->
        <!-- 以后换链接：把下面两处 百度链接 都换掉；提取码改在 name 那一行 -->
        <div class="card">
            <div class="name"><span class="badge bd-badge">百</span> 百度网盘</div>
            <div class="code">提取码：nbZf</div>
            <div class="link-box" id="bdLink">https://pan.baidu.com/s/1NFVwW1pX__RNHblOxkgVyQ?pwd=nbZf</div>
            <div class="btn-row">
                <a href=" " class="btn bd-btn" target="_blank" rel="noopener">打开链接</a >
                <button class="btn copy-btn" onclick="copyText('bdLink')">复制链接</button>
            </div>
        </div>

        <!-- ===== 夸克网盘卡片 ===== -->
        <!-- 以后换链接：把下面两处 夸克链接 都换掉 -->
        <div class="card">
            <div class="name"><span class="badge kk-badge">夸</span> 夸克网盘</div>
            <div class="link-box" id="kkLink">https://pan.quark.cn/s/35569c4b4c09</div>
            <div class="btn-row">
                <a href="https://pan.quark.cn/s/35569c4b4c09" class="btn kk-btn" target="_blank" rel="noopener">打开链接</a >
                <button class="btn copy-btn" onclick="copyText('kkLink')">复制链接</button>
            </div>
        </div>

        <!-- ===== 迅雷云盘卡片 ===== -->
        <!-- 以后换链接：把下面两处 迅雷链接 都换掉；提取码改在 code 那一行 -->
        <div class="card">
            <div class="name"><span class="badge xl-badge">迅</span> 迅雷云盘</div>
            <div class="code">提取码：3uz6</div>
            <div class="link-box" id="xlLink">https://pan.xunlei.com/s/VP6yFWN1bY66XtGk0jgEXA1?pwd=3uz6</div>
            <div class="btn-row">
                <a href="https://pan.xunlei.com/s/VP6yFWN1bY66XtGk0jgEXA1?pwd=3uz6" class="btn xl-btn" target="_blank" rel="noopener">打开链接</a >
                <button class="btn copy-btn" onclick="copyText('xlLink')">复制链接</button>
            </div>
        </div>

        <div class="footer">如有链接失效，请重新获取后更新页面</div>
    </div>

    <script>
        // 复制链接：先尝试新版复制方式，不支持时用老办法兜底，保证微信里也能用
        function copyText(id) {
            const el = document.getElementById(id);
            const text = el.innerText.trim();

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(function () {
                    alert("链接已复制，请用浏览器或网盘 App 打开");
                }).catch(function () {
                    fallbackCopy(text);
                });
            } else {
                fallbackCopy(text);
            }
        }

        function fallbackCopy(text) {
            const ta = document.createElement("textarea");
            ta.value = text;
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            try {
                document.execCommand("copy");
                alert("链接已复制，请用浏览器或网盘 App 打开");
            } catch (e) {
                alert("复制失败，请长按链接手动复制");
            }
            document.body.removeChild(ta);
        }
    </script>
</body>
</html>
